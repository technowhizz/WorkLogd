# Application
# APP_NAME is the product name shown throughout the UI. It reaches the frontend as a shared
# Inertia prop, so renaming it here renames every label that refers to the app by name.
# Note: the browser tab title comes from VITE_APP_NAME at the bottom of this file, which Vite
# bakes in at build time - change this and the tab title only follows after `npm run build`.
APP_NAME="WorkLog'd"
APP_ENV=local
APP_KEY=base64:UNQNf1SXeASNkWux01Rj8EnHYx8FO0kAxWNDwktclkk=
APP_DEBUG=true
APP_URL=https://solidtime.test
APP_FORCE_HTTPS=false
APP_ENABLE_REGISTRATION=true
# Comma separated emails that always have access to the admin panel at /admin. Everyone else is
# granted it from inside the panel, so this list only needs the first admin - and is the way back
# in if that access is ever revoked by mistake.
SUPER_ADMINS=admin@example.com
PAGINATION_PER_PAGE_DEFAULT=500

# Billing. Subscriptions are recorded in the admin panel; turn enforcement on to have those
# records actually decide what an organization may do.
BILLING_ENFORCE=false
BILLING_CURRENCY=GBP
# Per-seat Stripe price IDs for the Professional plan. Enterprise is negotiated and recorded by
# hand in the admin portal, so it deliberately has no price here.
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_YEARLY=

# Stripe. The webhook secret is what makes an incoming webhook trustworthy - without it anyone
# who knows the URL can tell this instance a subscription is paid for.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=gbp

# Third-party credentials (Jira and Google tokens) are encrypted under this key rather than
# APP_KEY. Keep it somewhere the application environment is not - a secrets manager, a KMS, an
# injected file - so a leaked .env costs you sessions rather than every customer's issue tracker.
# Leave empty to fall back to APP_KEY, then run `admin:credentials:rotate-key` after setting it.
# Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
CREDENTIAL_ENCRYPTION_KEY=

# Logging
LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=deprecation
LOG_LEVEL=debug

# Database
# Postgres only - the app uses jsonb, partial unique indexes and date_bin(), so SQLite and
# MySQL will not work.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=root

# phpunit.xml points the test suite at this connection, and RefreshDatabase shells out to the
# psql binary to load database/schema/pgsql_test-schema.sql - without psql on PATH every
# database test fails with a ProcessFailedException.
DB_TEST_HOST=pgsql_test
DB_TEST_PORT=5432
DB_TEST_DATABASE=laravel
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=root

# Broadcasting
BROADCAST_DRIVER=null

# Cache
# Must be shared between processes. The Google Calendar per-day event cache and the Jira sync
# run progress both live here, and a queued sync writes its progress from the worker while the
# browser polls for it through the web process. "file", "database" and "redis" all work;
# "array" does not.
CACHE_DRIVER=file

# Queue
# "sync" runs jobs inline, which is fine for development. A Jira sync then blocks the request
# until it finishes and its progress bar jumps straight to done. For real background behaviour
# use "database" or "redis" and run `php artisan queue:work`.
QUEUE_CONNECTION=sync

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@solidtime.test"
MAIL_FROM_NAME="WorkLog'd"
MAIL_REPLY_TO_ADDRESS="hello@solidtime.test"
MAIL_REPLY_TO_NAME="WorkLog'd"

# Filesystems
FILESYSTEM_DISK=s3
PUBLIC_FILESYSTEM_DISK=s3
S3_ACCESS_KEY_ID=sail
S3_SECRET_ACCESS_KEY=password
S3_REGION=us-east-1
S3_BUCKET=local
S3_URL=http://storage.solidtime.test/local
S3_ENDPOINT=http://storage.solidtime.test
S3_USE_PATH_STYLE_ENDPOINT=true

# Passport
# Run `php artisan passport:keys` once, then `php artisan db:seed` to create the personal
# access client these IDs refer to - the end to end tests need it to mint API tokens.
PASSPORT_PERSONAL_ACCESS_CLIENT_ID="9e27f54d-5dfb-4dde-99d7-834518236c92"
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET="EL5mXp3aF8ITjcwoOXRpbSK7zGrWhW4zTDpQXTkf"

# Auditing
AUDITING_ENABLED=true

# Telescope
TELESCOPE_ENABLED=false

# Services
# Needed by the PDF export - one time entry export test fails without it.
GOTENBERG_URL=http://gotenberg:3000

# Jira integration (optional) - an OAuth 2.0 (3LO) app from developer.atlassian.com. Resource
# level access, scopes read:jira-work, write:jira-work and read:me. The callback is
# <APP_URL>/integrations/jira/callback. Without these the integration stays hidden.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Google Calendar integration (optional) - create a Web application OAuth client
# at https://console.cloud.google.com/apis/credentials and enable the Google Calendar API.
# The redirect URI is <APP_URL>/integrations/google-calendar/callback.
# Leave unset to hide the integration entirely.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Jira integration (optional) - deliberately has no environment variables.
# The Jira site URL is set per organization by an administrator under Organization Settings,
# and each member supplies their own Atlassian API token under Profile Settings, so worklogs
# are attributed to them rather than to a shared account. Tokens are encrypted at rest with
# APP_KEY. Nothing to configure here.

# Octane
OCTANE_SERVER=frankenphp

# Local setup
NGINX_HOST_NAME=solidtime.test
NETWORK_NAME=reverse-proxy-docker-traefik_routing
FORWARD_DB_PORT=54329
VITE_HOST_NAME=vite.solidtime.test
VITE_APP_NAME="${APP_NAME}"
#SAIL_XDEBUG_MODE=develop,debug,coverage
