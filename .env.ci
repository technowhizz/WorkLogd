# Application
APP_NAME="WorkLog'd"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FORCE_HTTPS=false
APP_ENABLE_REGISTRATION=true

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=pgsql_test
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=5432
DB_TEST_DATABASE=laravel
DB_TEST_USERNAME=root
DB_TEST_PASSWORD=root

# Broadcasting
BROADCAST_DRIVER=null

# Cache
CACHE_DRIVER=file

# Queue
QUEUE_CONNECTION=sync

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Mail
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@solidtime.test"
MAIL_FROM_NAME="WorkLog'd"
MAIL_REPLY_TO_ADDRESS="hello@solidtime.test"
MAIL_REPLY_TO_NAME="WorkLog'd"

# Filesystems
FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DISK=public

# Passport
PASSPORT_PERSONAL_ACCESS_CLIENT_ID="9e27f54d-5dfb-4dde-99d7-834518236c92"
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET="EL5mXp3aF8ITjcwoOXRpbSK7zGrWhW4zTDpQXTkf"

# Auditing
AUDITING_ENABLED=true

# Telescope
TELESCOPE_ENABLED=false

# Services
GOTENBERG_URL=http://localhost:3000
# Google Calendar integration - placeholder credentials so the integration is enabled
# in the UI for the end to end tests. Google itself is never contacted, the tests stub
# solidtime's own API. Real installations set their own credentials, see .env.example.
GOOGLE_CLIENT_ID=ci-google-client-id
GOOGLE_CLIENT_SECRET=ci-google-client-secret

# Jira integration, the same arrangement as Google above: placeholder OAuth credentials
# so the integration is enabled rather than hidden, plus the fake client so connecting an
# account and sending worklogs complete without an Atlassian site. Without all three the
# whole Jira suite fails on a connection it can never make. FakeJiraClient::isEnabled()
# refuses to switch on in production, so the flag is inert outside CI and local runs.
JIRA_CLIENT_ID=ci-jira-client-id
JIRA_CLIENT_SECRET=ci-jira-client-secret
JIRA_FAKE_CLIENT=true

# Octane
OCTANE_SERVER=frankenphp
